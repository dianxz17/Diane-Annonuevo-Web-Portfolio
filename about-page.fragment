function aboutPage(){
 const biography=[
 "I'm Diane M. Annonuevo, a third-year Bachelor of Science in Information Technology student at City College of Calamba with a growing interest in web design, graphic design, and technology.",
 "Since 2022, I've been accepting freelance commissions involving work immersion portfolios, web design projects, and various basic editing tasks. These experiences have given me opportunities to explore different creative projects, work with client requirements, and gradually develop my design skills.",
 "I'm also exploring graphic design and continuously learning how to improve my creativity and visual communication. On the technical side, I have foundational knowledge of coding and hands-on experience in assembling and disassembling computers, setting up printers, working with network cables, and performing basic networking tasks.",
 "While I'm still developing my skills, I enjoy learning through practical experience and exploring how design and technology can work together to create useful and meaningful digital solutions."
 ];
 const facts=[['Full Name',d.name],['Location',d.location],['Education','BS Information Technology'],['School','City College of Calamba'],['Creative Focus','Web & Graphic Design'],['Freelance Commissions','Since 2022'],['Technical Interests','Computer Hardware, IT Support, Basic Networking'],['Current Status','Student & Aspiring Designer']];
 const offerings=[
 {title:'Creative Commissions',icon:'<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 10h6M9 14h6M9 18h4"/>',description:"Since 2022, I've worked on commissioned projects such as work immersion portfolios, basic editing tasks, and web design projects. These experiences have helped me strengthen my creativity, attention to detail, and ability to work with different client requirements."},
 {title:'Web & Graphic Design',icon:'<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 9v11M6 6.5h.01M9 6.5h.01"/>',description:"I'm continuously exploring web and graphic design, from creating layouts and editing visual materials to learning how to build functional and visually engaging web interfaces."},
 {title:'Technical & IT Skills',icon:'<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9zM9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',description:'I have foundational experience in computer assembly and disassembly, printer setup, network cabling, basic networking, and coding. I continue to develop these skills through academic activities and hands-on practice.'}
 ];
 return `<div class="about-page">${heading('THE PERSON BEHIND THE WORK','A little about me.','Get to know my background, creative journey, and growing interest in design and technology.')}<section class="section about-intro" aria-labelledby="journey-title"><div class="about-biography"><span class="eyebrow">MY CREATIVE JOURNEY</span><h2 id="journey-title">Where creativity meets technology.</h2>${biography.map(p=>`<p>${esc(p)}</p>`).join('')}<div class="actions">${btn('/projects','Explore My Projects')}</div></div><aside class="about-information" aria-labelledby="information-title"><span class="eyebrow">AT A GLANCE</span><h2 id="information-title">A few things about me.</h2><dl class="facts">${facts.map(([label,value])=>`<div><dt>${esc(label)}</dt><dd>${esc(value)}</dd></div>`).join('')}</dl></aside></section><section class="section about-offerings" aria-labelledby="what-i-do"><div class="section-head"><div><span class="eyebrow">DESIGN &amp; TECHNOLOGY</span><h2 id="what-i-do">What I Do</h2></div></div><div class="grid">${offerings.map(o=>`<article class="card"><div class="card-body"><span class="about-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${o.icon}</svg></span><h3>${esc(o.title)}</h3><p>${esc(o.description)}</p></div></article>`).join('')}</div></section><section class="about-philosophy" aria-labelledby="philosophy-title"><span class="eyebrow">MY APPROACH</span><h2 id="philosophy-title">Learning, creating, and improving.</h2><p>${esc("I believe that creativity and technical knowledge can complement each other. Whether I'm designing a layout, working on a commission, or learning something technical, I approach each task as an opportunity to improve my skills and gain experience.")}</p><p>${esc("I'm still exploring different areas of IT and design, but I'm motivated to keep learning, experimenting, and creating work that I can be proud of.")}</p></section></div>`;
}
